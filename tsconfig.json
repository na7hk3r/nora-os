{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./apps/desktop/src/*"],
      "@core/*": ["./apps/desktop/src/core/*"],
      "@plugins/*": ["./apps/desktop/src/plugins/*"]
    }
  },
  "include": ["apps/desktop/src/**/*", "apps/desktop/electron/**/*"],
  "exclude": ["node_modules", "dist", "out"]
}
